# Environment variables for PCN Triage Orchestrator
# Copy this file to .env and fill in real values.
# NEVER commit the .env file — it is gitignored.

# GCP project and region where all infrastructure lives
GCP_PROJECT_ID=
GCP_REGION=

# Fine-grained GitHub Personal Access Token
# Required scopes on the target repo: Contents: write, Pull requests: write
GITHUB_TOKEN=

# GitHub repository for HAL updates (owner/repo format or full HTTPS URL)
GITHUB_TARGET_REPO=

# Gmail OAuth 2.0 credentials for the watched mailbox
# Obtain by running: python scripts/gmail_oauth_setup.py path/to/client_secret.json
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Watched Gmail address (informational — watch is registered via users.watch())
GMAIL_WATCHED_ADDRESS=

# Full Pub/Sub topic name (projects/<project>/topics/<topic>)
GMAIL_PUBSUB_TOPIC=

# GCS bucket names (buckets are already provisioned, just fill in the names)
GCS_RAW_DOCUMENTS_BUCKET=pcn-raw-documents
GCS_ECO_OUTPUTS_BUCKET=eco-outputs

# Cloud Run service URLs — set to each service's own URL for OIDC audience verification
# Example: https://pcn-ingestor-xxxx-el.a.run.app
# Leave blank to skip strict audience checking (not recommended for production)
SERVICE_URL=
