%%{init: {'theme': 'default'}}%%
sequenceDiagram
    participant Gmail as Gmail API
    participant PubSub as Pub/Sub (gmail-pcn-notifications)
    participant Ingestor as pcn-ingestor
    participant GCS as pcn-raw-documents

    Gmail->>PubSub: Push Notification (historyId)
    PubSub->>Ingestor: POST / (with OIDC Bearer Token)
    
    rect rgb(245, 245, 255)
        Note over Ingestor: Verify OIDC Auth Signature
        Ingestor->>Gmail: history.list(startHistoryId)
        Gmail-->>Ingestor: Message IDs
        Ingestor->>Gmail: messages.get(id)
        Gmail-->>Ingestor: Message Payload & Headers
        
        Note over Ingestor: Verify 'From' against ALLOWED_SENDERS
        
        Ingestor->>Gmail: messages.attachments.get(id)
        Gmail-->>Ingestor: Base64 PDF Data
        
        Note over Ingestor: Decode Base64url
        Ingestor->>GCS: Upload <msg_id>.pdf
        GCS-->>Ingestor: Success
    end
    
    Ingestor-->>PubSub: 200 OK
