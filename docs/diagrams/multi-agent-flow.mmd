stateDiagram-v2
    direction TB
    
    [*] --> TriageAgent: CloudEvent (GCS finalize)
    
    state "Stage 1: Triage" as TriageAgent {
        ParsePDF: Extract Parts (Gemini)
        ReturnParts: Output JSON {"parts": [...]}
        ParsePDF --> ReturnParts
    }
    
    TriageAgent --> ResolutionAgent: Pass Parsed JSON via new_message
    
    state "Stage 2: Resolution" as ResolutionAgent {
        QueryDB: query_firestore_inventory
        ReturnResolution: Output JSON {"parts": [{"found": bool}]}
        QueryDB --> ReturnResolution
    }
    
    ResolutionAgent --> ActionAgent: Pass Parsed JSON via new_message
    
    state "Stage 3: Action" as ActionAgent {
        CheckFound: Iterate Found Parts
        CreateECO: generate_eco_pdf
        CreatePR: github_create_pr
        CheckFound --> CreateECO
        CheckFound --> CreatePR
    }
    
    ActionAgent --> WriteState: Output JSON
    
    state "State Persistence" as WriteState {
        LogDB: Write to agent_runs (Firestore)
    }
    
    WriteState --> [*]: Return 200 OK
